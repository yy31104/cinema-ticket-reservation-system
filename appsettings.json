{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=app.db;Cache=Shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Reservations": {
    "MaxSeatsPerUserPerScreening": 6
  },
  "RateLimiting": {
    "Login": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Reservations": { "PermitLimit": 30, "WindowSeconds": 60 }
  }
}
